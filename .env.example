# Copiar a .env y ajustar en local. En producción estas variables las pone el entorno de deploy.

ENVIRONMENT=development

# Puerto 5433 en local: el 5432 del host ya lo usa otro proyecto (docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://ghastly:ghastly@localhost:5433/ghastly

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-every-environment-min-32-bytes
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=60

ALLOW_REGISTRATION=true

LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:8081

# Fase 5 (recibos + /export) — Cloudflare R2, compatible con la API de S3.
# AWS_REGION=auto para R2. S3_ENDPOINT_URL es la URL de cuenta de R2
# (https://<account_id>.r2.cloudflarestorage.com); vacío = AWS S3 real.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_ENDPOINT_URL=
S3_BUCKET_RECEIPTS=
